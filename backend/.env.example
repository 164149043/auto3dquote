# PrusaSlicer 配置
# Windows: D:\Program Files\Prusa3D\PrusaSlicer\prusa-slicer-console.exe
# Linux:   /opt/prusaslicer/prusa-slicer
PRUSA_SLICER_PATH=/opt/prusaslicer/prusa-slicer
PRUSA_SLICER_TIMEOUT=300

# 文件上传限制 (MB)
MAX_FILE_SIZE_MB=100

# 管理后台 Token（留空则启动时自动生成并打印到日志）
ADMIN_TOKEN=

# 管理员种子账号（仅首次启动时创建，留空则不创建）
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# 日志级别
LOG_LEVEL=INFO
